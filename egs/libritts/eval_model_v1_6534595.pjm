#!/bin/bash
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=04:00:00
#PJM -L jobenv=singularity
#PJM -o logs/eval_v1_6534595_%j.out
#PJM -e logs/eval_v1_6534595_%j.err

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

mkdir -p logs exp/eval_valle_test_v1_6534595

module load singularity-ce

SIF="${SIF:-$HOME/latest.sif}"

singularity exec --nv --bind "$HOME" "$SIF" bash "${SCRIPT_DIR}/eval_valle_test_neumark.sh" \
    --checkpoint exp/tts_native_neumark/20260819-112728/NeuMark_final.pt \
    --output-dir exp/eval_valle_test_v1_6534595
