#!/bin/bash
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=00:30:00
#PJM -L jobenv=singularity
#PJM -o logs/diagnose_valle_token_vs_checkpoint_%j.out
#PJM -e logs/diagnose_valle_token_vs_checkpoint_%j.err

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

mkdir -p logs exp/diagnose_valle_token_vs_checkpoint

module load singularity-ce

SIF="${SIF:-$HOME/latest.sif}"

singularity exec --nv --bind "$HOME" "$SIF" \
    bash "${SCRIPT_DIR}/diagnose_valle_token_vs_checkpoint.sh" "$@"
