#!/bin/bash
#PJM -L rscgrp=b-batch
#PJM -L gpu=1
#PJM -L elapse=72:00:00
#PJM -L jobenv=singularity
#PJM -o logs/generate_valle_native_dataset_%j.out
#PJM -e logs/generate_valle_native_dataset_%j.err

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

mkdir -p logs

module load singularity-ce

SIF="${SIF:-$HOME/latest.sif}"
JOB_ID="${PJM_JOBID:-manual}"
MONITOR_LOG="logs/monitor_dataset_${JOB_ID}.log"

# Background resource monitor
(
    while true; do
        echo "===== $(date) ====="
        singularity exec --nv --bind "$HOME" "$SIF" nvidia-smi || true
        ps -u "$USER" -o pid,ppid,pcpu,pmem,etime,cmd --sort=-pcpu | head -30 || true
        sleep 60
    done
) > "$MONITOR_LOG" 2>&1 &

MONITOR_PID=$!
trap 'kill "$MONITOR_PID" 2>/dev/null || true' EXIT

echo "Monitor log: $MONITOR_LOG"
singularity exec --nv --bind "$HOME" "$SIF" bash "${SCRIPT_DIR}/generate_valle_native_dataset.sh" "$@"
