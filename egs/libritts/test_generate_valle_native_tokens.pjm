#!/bin/bash
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=01:00:00
#PJM -L jobenv=singularity
#PJM -o logs/test_generate_valle_native_tokens_%j.out
#PJM -e logs/test_generate_valle_native_tokens_%j.err

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

mkdir -p logs exp/test_generate_valle_native_tokens

module load singularity-ce

SIF="${SIF:-$HOME/latest.sif}"

singularity exec --nv --bind "$HOME" "$SIF" \
    bash "${SCRIPT_DIR}/test_generate_valle_native_tokens.sh"
