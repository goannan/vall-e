#!/bin/bash
#PJM -L rscgrp=b-batch
#PJM -L gpu=1
#PJM -L elapse=144:00:00
#PJM -L jobenv=singularity
#PJM -o logs/train_speechtokenizer_valle_genkai_%j.out
#PJM -e logs/train_speechtokenizer_valle_genkai_%j.err

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "${SCRIPT_DIR}"
mkdir -p logs

module load singularity-ce
SIF="${SIF:-$HOME/latest.sif}"

singularity exec --nv --bind "$HOME" "$SIF" \
    bash "${SCRIPT_DIR}/train_speechtokenizer_valle_genkai.sh" "$@"
