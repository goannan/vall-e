#!/bin/bash
#PJM -L rscgrp=b-batch-mig
#PJM -L gpu=1
#PJM -L elapse=00:30:00
#PJM -L jobenv=singularity
#PJM -o logs/test_prepare_speechtokenizer_genkai_%j.out
#PJM -e logs/test_prepare_speechtokenizer_genkai_%j.err

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "${SCRIPT_DIR}"
mkdir -p logs
module load singularity-ce
singularity exec --nv --bind "$HOME" "${SIF:-$HOME/latest.sif}" \
    bash "${SCRIPT_DIR}/test_prepare_speechtokenizer_genkai.sh"
